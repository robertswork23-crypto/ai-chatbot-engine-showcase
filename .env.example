# Copy to .env for local dev. In production these are set as Railway service
# Variables, never committed.

ENVIRONMENT=development

# Leave unset locally to fall back to SQLite (./chatbot_engine.db). Must be a
# real Postgres connection string in production.
DATABASE_URL=

# Required to enable chat and knowledge-base embedding. Without it, /api/chat
# returns a friendly "not configured" message and the knowledge base won't seed.
OPENAI_API_KEY=

# Required in production for signed JWTs; any value works for local dev.
JWT_SECRET=

FRONTEND_URL=http://localhost:5173

# Nivor Chat Pro subscription billing — all optional. Without these,
# /api/billing/checkout and /api/billing/webhook return a clear 501 instead
# of erroring.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
